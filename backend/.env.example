# -------- Local DEMO (no external writes) --------
# Start `uvicorn gateway:app --host 127.0.0.1 --port 8088` with everything below unset.

# -------- CONNECTED MODE (set only in SERVER secrets, never in the frontend) --------
SOCIAL_BASE_URL=https://social.internal.yuj.example
SOCIAL_ADMIN_KEY=replace_with_existing_social_admin_key
RENDERER_BASE_URL=https://renderer.internal.yuj.example
RENDERER_API_KEY=replace_with_existing_renderer_key
YUJ_CONSOLE_PASSWORD=replace_with_a_strong_operator_password
YUJ_SESSION_SECRET=replace_with_random_secret_at_least_32_chars_long
YUJ_CONSOLE_ORIGIN=https://studio.yuj.example
YUJ_COOKIE_SECURE=true
YUJ_ALLOW_HTTP_UPSTREAM=false

# For LOCAL development ONLY with localhost HTTP services, choose appropriate settings:
# SOCIAL_BASE_URL=http://127.0.0.1:8090
# RENDERER_BASE_URL=http://127.0.0.1:8100
# YUJ_CONSOLE_ORIGIN=http://127.0.0.1:8088
# YUJ_ALLOW_HTTP_UPSTREAM=true
# YUJ_COOKIE_SECURE=false
