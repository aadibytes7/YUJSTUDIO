# ==============================================================================
# YUJ STUDIO — MARKETING INTELLIGENCE OS
# Environment Configuration Template (.env.example)
# ==============================================================================

# -------- LOCAL DEMO MODE (Offline Simulation) --------
# In Demo Mode, external writes are simulated locally. All upstream settings below can remain unset.
ENV_MODE=demo
GATEWAY_PORT=8088
GATEWAY_HOST=127.0.0.1

# -------- PRODUCTION / CONNECTED MODE --------
# Set only in secure server environment variables — NEVER commit real secrets to source control.

# Social Studio Backend API
SOCIAL_BASE_URL=https://social.internal.yuj.example
SOCIAL_ADMIN_KEY=your_social_studio_admin_key_here

# Engine15 Renderer Adapter API
RENDERER_BASE_URL=https://renderer.internal.yuj.example
RENDERER_API_KEY=your_renderer_api_key_here

# Operator Authentication & Console Security
YUJ_CONSOLE_PASSWORD=your_strong_operator_password_here
YUJ_SESSION_SECRET=your_32_character_random_hex_secret_here
YUJ_CONSOLE_ORIGIN=https://studio.yuj.example
YUJ_COOKIE_SECURE=true
YUJ_ALLOW_HTTP_UPSTREAM=false

# Optional Upstream Microservices
# EVENT_BUS_URL=http://127.0.0.1:8002
